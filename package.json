{
  "name": "card-board-hybrid",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "install-hooks": "git config core.hooksPath .githooks",
    "ci:local": "scripts/ci-local.sh",
    "dev:backend": "cargo run -p backend",
    "dev:frontend": "cd frontend && bun run dev --host 0.0.0.0",
    "build": "cargo build --workspace && bun run --cwd frontend build",
    "test": "cargo test --workspace && bun run --cwd frontend typecheck"
  },
  "packageManager": "bun@1.3.14"
}
